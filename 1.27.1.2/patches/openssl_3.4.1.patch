+//-----------------------------
+int tls_parse_ctos_record_size_limit(SSL_CONNECTION *s, PACKET *pkt, unsigned int context,
+                                     X509 *x, size_t chainidx)
+{
+
+    unsigned int limit;
+    size_t remaining;
+
+    remaining = PACKET_remaining(pkt);
+    if (remaining < 2) {
+        SSLfatal_data(s, SSL_AD_DECODE_ERROR, SSL_F_TLS_PARSE_CTOS_RECORD_SIZE_LIMIT,
+                      "Record size limit extension too short");
+        return 0;
+    }
+
+    if (!PACKET_get_net_2(pkt, &limit)) {
+        SSLfatal_data(s, SSL_AD_DECODE_ERROR, SSL_F_TLS_PARSE_CTOS_RECORD_SIZE_LIMIT,
+                      "Bad extension data");
+        return 0;
+    }
+
+    s->record_size_limit = limit;
+
+    return 1;
+}
