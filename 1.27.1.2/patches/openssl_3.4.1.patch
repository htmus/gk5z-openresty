+//---------------------------------
+int ossl_ch_extract_extlist(SSL *ssl, int **result, size_t *total)
+{
+    const SSL_CONNECTION *conn = SSL_CONNECTION_FROM_SSL(ssl);
+    PACKET pkt = conn->clienthello->extensions;
+    size_t ext_count = 0, pos = 0;
+    int *list;
+
+    while (PACKET_remaining(&pkt) > 0) {
+        unsigned int t;
+        PACKET tmp;
+        if (!PACKET_get_net_2(&pkt, &t) || !PACKET_get_length_prefixed_2(&pkt, &tmp))
+            return 0;
+        ++ext_count;
+    }
+
+    list = OPENSSL_malloc(sizeof(int) * ext_count);
+    if (list == NULL)
+        return 0;
+
+    pkt = conn->clienthello->extensions;
+    while (PACKET_remaining(&pkt) > 0 && pos < ext_count) {
+        unsigned int t;
+        PACKET tmp;
+        if (!PACKET_get_net_2(&pkt, &t) || !PACKET_get_length_prefixed_2(&pkt, &tmp)) {
+            OPENSSL_free(list);
+            return 0;
+        }
+        list[pos++] = (int)t;
+    }
+
+    *result = list;
+    *total = ext_count;
+    return 1;
+}
+//---------------------------------
+const unsigned char *SSL_SESSION_get_ticket_id(const SSL_SESSION *s, size_t *len) {
+    if (s == NULL || s->ext.tick == NULL || s->ext.ticklen < 16) {
+        if (len != NULL)
+            *len = 0;
+        return NULL;
+    }
 
+    if (len != NULL)
+        *len = 16;
+
+    return s->ext.tick;
+}
+//---------------------------------
+void SSL_CTX_get_client_hello_cb(SSL_CTX *ctx,
+                                 int (**cb)(SSL *, int *, void *),
+                                 void **arg)
+{
+    if (ctx == NULL)
+        return;
+
+    if (cb != NULL)
+        *cb = ctx->client_hello_cb;
+    if (arg != NULL)
+        *arg = ctx->client_hello_cb_arg;
+}
