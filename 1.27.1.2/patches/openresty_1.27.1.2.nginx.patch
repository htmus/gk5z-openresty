+//---------------------------------------
+// adds ciphers to the ssl object for gk5z fingerprint
+ngx_int_t
+ngx_SSL_client_features(ngx_connection_t *c) {
+
+    SSL *s = NULL;
+
+    if (c == NULL) {
+        return NGX_ERROR;
+    }
+    s = c->ssl->connection;
+
+    if (!SSL_is_server(s)) {
+        return NGX_OK;
+    }
+
+    ngx_uint_t MAX_CIPHERS = 255;
+    uint16_t tmp_ciphers[MAX_CIPHERS];
+    ngx_uint_t real_cipher_count = 0;
+
+    STACK_OF(SSL_CIPHER) *_ciphers = SSL_get_client_ciphers(s);
+
+    if (_ciphers == NULL) {
+        ngx_log_error(NGX_LOG_ERR, c->log, 0, "ssl_features: failed to get client ciphers");
+        return NGX_ERROR;
+    }
+
+    ngx_uint_t total = sk_SSL_CIPHER_num(_ciphers);
+
+    ngx_log_debug1(NGX_LOG_DEBUG_EVENT, c->log, 0, "ssl_features: chiphers total=%d", total);
+
+    for (ngx_uint_t i = 0; i < total && real_cipher_count < MAX_CIPHERS; i++) {
+        const SSL_CIPHER *cipher = sk_SSL_CIPHER_value(_ciphers, i);
+        if (cipher == NULL) {
+            continue;
+        }
+
+        uint32_t cipher_id = SSL_CIPHER_get_id(cipher);
+        uint16_t cipher_code = (uint16_t)(cipher_id & 0xFFFF);
+
+        tmp_ciphers[real_cipher_count] = cipher_code;
+        real_cipher_count++;
+    }
+
+    ngx_log_debug1(NGX_LOG_DEBUG_EVENT, c->log, 0, "ssl_features: real_cipher_count=%d", real_cipher_count);
+
+    c->ssl->ciph = ngx_pnalloc(c->pool, real_cipher_count * sizeof(uint16_t));
+    if (c->ssl->ciph == NULL) {
+        ngx_log_error(NGX_LOG_ERR, c->log, 0, "ssl_features: can't allocate memory for c->ssl->ciph");
+        return NGX_ERROR;
+    }
+
+    ngx_memzero(c->ssl->ciph, real_cipher_count * sizeof(uint16_t));
+    ngx_memcpy(c->ssl->ciph, tmp_ciphers, real_cipher_count * sizeof(uint16_t));
+
+    c->ssl->ciph_sz = real_cipher_count;
+
+    ngx_log_debug0(NGX_LOG_DEBUG_EVENT, c->log, 0, "ssl_features: fuinction done.");
+
+    int _num_sigalgs = SSL_get_sigalgs(s, 0, NULL, NULL, NULL, NULL, NULL);
+    if (_num_sigalgs <= 0) {
+        c->ssl->sglgs_sz = 0;
+        c->ssl->sglgs = NULL;
+        return NGX_OK;
+    }
+
+    uint16_t *sigalgs = ngx_pnalloc(c->pool, _num_sigalgs * sizeof(uint16_t));
+    if (sigalgs == NULL) {
+        ngx_log_error(NGX_LOG_ERR, c->log, 0, 
+                      "Failed to allocate memory for signature algorithms");
+        return NGX_ERROR;
+    }
+
+    for (int i = 0; i < _num_sigalgs; i++) {
+        int sign, hash, signhash;
+        unsigned char rsig, rhash;
+        SSL_get_sigalgs(s, i, &sign, &hash, &signhash, &rsig, &rhash);
+
+        sigalgs[i] = (uint16_t)((rhash << 8) | rsig);
+    }
+
+    c->ssl->sglgs = sigalgs;
+    c->ssl->sglgs_sz = (size_t)_num_sigalgs;
+
+    return NGX_OK;
+}
+// adds extensions to the ssl object for gk5z fingerprint
+//-----------------------------------------------------------------
+int
+ngx_SSL_early_cb_fn(SSL *s, int *al, void *arg)
+{
+    int               *ext_out;
+    size_t             ext_len;
+    int                ret;
+
+    ngx_ssl_client_hello_chain_t *chain = (ngx_ssl_client_hello_chain_t *)arg;
+    ngx_connection_t *c = chain->c;
+    int rc = 1;
+
+    c->ssl->extn_sz = 0;
+    c->ssl->extn = NULL;
+
+    ret = ossl_ch_extract_extlist(s, &ext_out, &ext_len);
+    if (!ret || !ext_out || !ext_len) {
+        ngx_log_error(NGX_LOG_WARN, c->log, 0, "ngx_SSL_early_cb_fn: Failed to get ClientHello extensions in early_cb");
+        return 1;
+    }
+
+    if (ext_out && ext_len > 0) {
+        c->ssl->extn = ngx_palloc(c->pool, sizeof(char *) * ext_len);
+        if (c->ssl->extn) {
+            c->ssl->extn_sz = ext_len;
+            c->ssl->extn = ngx_palloc(c->pool, ext_len * sizeof(uint16_t));
+            ngx_memzero(c->ssl->extn,ext_len * sizeof(uint16_t));
+            if (c->ssl->extn) {
+                for (size_t i = 0; i < ext_len; i++) {
+                    c->ssl->extn[i] = ext_out[i];
+                }
+            } else {
+                c->ssl->extn_sz = 0;
+            }
 
+        }
+    }
+    OPENSSL_free(ext_out);
 
+    int alpn_found = 0;
+    for (size_t i = 0; i < ext_len; i++) {
+        if (ext_out[i] == 0x0010) {
+            alpn_found = 1;
+            break;
+        }
+    }
+
+    if (alpn_found && c->ssl->client_alpns == NULL) {
+        const unsigned char *alpn_data;
+        size_t alpn_len;
+        if (SSL_client_hello_get0_ext(s, 0x0010, &alpn_data, &alpn_len)) {
+            const unsigned char *p = alpn_data;
+            const unsigned char *end = alpn_data + alpn_len;
+            if (p + 2 <= end) {
+                size_t alpn_list_len = (p[0] << 8) + p[1];
+                p += 2;
+                if (p + alpn_list_len <= end) {
+                    size_t total_len = 0;
+                    const unsigned char *start = p;
+                    while (p < end) {
+                        if (p + 1 > end) break;
+                        size_t len = *p++;
+                        if (p + len > end) break;
+                        total_len += len + 1;
+                        p += len;
+                    }
+                    if (total_len > 0) {
+                        c->ssl->client_alpns = ngx_palloc(c->pool, total_len + 1);
+                        if (c->ssl->client_alpns) {
+                            p = start;
+                            size_t pos = 0;
+                            while (p < end) {
+                                if (p + 1 > end) break;
+                                size_t len = *p++;
+                                if (p + len > end) break;
+                                if (pos > 0) {
+                                    c->ssl->client_alpns[pos++] = ',';
+                                }
+                                ngx_memcpy(c->ssl->client_alpns + pos, p, len);
+                                pos += len;
+                                p += len;
+                            }
+                            c->ssl->client_alpns[pos] = '\0';
+                            ngx_log_debug(NGX_LOG_INFO, c->log, 0, "ngx_SSL_early_cb_fn: Early CB: ALPN list extracted: %s", c->ssl->client_alpns);
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    const unsigned char *data;
+    size_t len;
+
+    len = SSL_client_hello_get0_compression_methods(s, &data);
+    if (len > 0) {
+        c->ssl->compr_mt = ngx_palloc(c->pool, len);
+        if (c->ssl->compr_mt == NULL) {
+            ngx_log_error(NGX_LOG_ERR, c->log, 0, 
+                          "ngx_SSL_early_cb_fn: failed to allocate compression methods");
+            *al = SSL_AD_INTERNAL_ERROR;
+            return SSL_CLIENT_HELLO_ERROR;
+        }
+        ngx_memcpy(c->ssl->compr_mt, data, len);
+        c->ssl->compr_mt_sz = len;
+    } else {
+        c->ssl->compr_mt = NULL;
+        c->ssl->compr_mt_sz = 0;
+    }    
+//Supproted versions
+    if (SSL_client_hello_get0_ext(s, TLSEXT_TYPE_supported_versions, &data, &len)) {
+        if (len > 1 && data[0] == len - 1) {
+            size_t num_versions = data[0] / 2;
+            c->ssl->supp_vers = ngx_palloc(c->pool, num_versions * sizeof(uint16_t));
+            if (c->ssl->supp_vers == NULL) {
+                ngx_log_error(NGX_LOG_ERR, c->log, 0, 
+                              "ngx_SSL_early_cb_fn: failed to allocate supported versions");
+                *al = SSL_AD_INTERNAL_ERROR;
+                return SSL_CLIENT_HELLO_ERROR;
+            }
+            c->ssl->supp_vers_sz = num_versions;
+
+            for (size_t i = 0; i < num_versions; i++) {
+                c->ssl->supp_vers[i] = (data[1 + i * 2] << 8) | data[2 + i * 2];
+            }
+        } else {
+            c->ssl->supp_vers = NULL;
+            c->ssl->supp_vers_sz = 0;
+            ngx_log_debug(NGX_LOG_DEBUG_EVENT, c->log, 0, "ngx_SSL_early_cb_fn: invalid supported versions");
+        }
+    } else {
+        c->ssl->supp_vers = NULL;
+        c->ssl->supp_vers_sz = 0;
+        ngx_log_debug(NGX_LOG_DEBUG_EVENT, c->log, 0, "ngx_SSL_early_cb_fn: no supported versions");
+    }
+// Supported Groups
+    if (SSL_client_hello_get0_ext(s, TLSEXT_TYPE_supported_groups, &data, &len)) {
+        if (len > 2 && (size_t)(data[0] << 8 | data[1]) == len - 2) {
+            size_t num_groups = (len - 2) / 2;
+            c->ssl->supp_groups = ngx_palloc(c->pool, num_groups * sizeof(uint16_t));
+            if (c->ssl->supp_groups == NULL) {
+                ngx_log_error(NGX_LOG_ERR, c->log, 0, "ngx_SSL_early_cb_fn: failed to allocate supported groups");
+                *al = SSL_AD_INTERNAL_ERROR;
+                return SSL_CLIENT_HELLO_ERROR;
+            }
+            c->ssl->supp_groups_sz = num_groups;
+
+            for (size_t i = 0; i < num_groups; i++) {
+                c->ssl->supp_groups[i] = (data[2 + i * 2] << 8) | data[3 + i * 2];
+            }
+
+        } else {
+            c->ssl->supp_groups = NULL;
+            c->ssl->supp_groups_sz = 0;
+            ngx_log_error(NGX_LOG_ERR, c->log, 0, "ngx_SSL_early_cb_fn: invalid supported groups");
+        }
+    } else {
+        c->ssl->supp_groups = NULL;
+        c->ssl->supp_groups_sz = 0;
+        ngx_log_debug(NGX_LOG_DEBUG_EVENT, c->log, 0, "ngx_SSL_early_cb_fn: no supported groups");
+    }
+// Padding
+    if (SSL_client_hello_get0_ext(s, TLSEXT_TYPE_padding, &data, &len)) {
+
+        size_t i;
+        for (i = 0; i < len; i++) {
+            if (data[i] != 0x00) {
+                ngx_log_error(NGX_LOG_ERR, c->log, 0, "ngx_SSL_early_cb_fn: invalid padding data");
+                *al = SSL_AD_ILLEGAL_PARAMETER;
+                return SSL_CLIENT_HELLO_ERROR;
+            }
+        }
+        c->ssl->padding_len = len;
+    } else {
+        c->ssl->padding_len = 0;
+    }
+// PSK Modes
+    if (SSL_client_hello_get0_ext(s, TLSEXT_TYPE_psk_kex_modes, &data, &len)) {
+        if (len > 1 && data[0] == len - 1) { // Проверяем формат: [len, mode1, mode2, ...]
+            size_t num_modes = data[0];
+            c->ssl->psk_modes = ngx_palloc(c->pool, num_modes);
+            if (c->ssl->psk_modes == NULL) {
+                ngx_log_error(NGX_LOG_ERR, c->log, 0, "ngx_SSL_early_cb_fn: failed to allocate psk modes");
+                *al = SSL_AD_INTERNAL_ERROR;
+                return SSL_CLIENT_HELLO_ERROR;
+            }
+            c->ssl->psk_modes_sz = num_modes;
+            ngx_memcpy(c->ssl->psk_modes, data + 1, num_modes);
+
+        } else {
+            c->ssl->psk_modes = NULL;
+            c->ssl->psk_modes_sz = 0;
+            ngx_log_error(NGX_LOG_ERR, c->log, 0, "ngx_SSL_early_cb_fn: invalid psk modes");
+        }
+    } else {
+        c->ssl->psk_modes = NULL;
+        c->ssl->psk_modes_sz = 0;
+    }
+
+//#ifdef __INTELLISENSE__  // This macro is defined only for the VSCode parser.
+#ifndef TLSEXT_TYPE_record_size_limit
+#define TLSEXT_TYPE_record_size_limit 28
+#endif
+//#endif
+
+// Record Size Limit
+    if (SSL_client_hello_get0_ext(s, TLSEXT_TYPE_record_size_limit, &data, &len)) {
+        if (len == 2) {
+            c->ssl->record_size_limit = (data[0] << 8) | data[1];
+            if (c->ssl->record_size_limit < 64 || c->ssl->record_size_limit > 16385) {
+                ngx_log_error(NGX_LOG_ERR, c->log, 0, "ngx_SSL_early_cb_fn: invalid record_size_limit: %ud", c->ssl->record_size_limit);
+            }
+        } else {
+            c->ssl->record_size_limit = 0;
+            ngx_log_error(NGX_LOG_ERR, c->log, 0, "ngx_SSL_early_cb_fn: invalid record_size_limit length: %ud", len);
+        }
+    } else {
+        c->ssl->record_size_limit = 0;
+    }
+
+    if (chain->original_cb) {
+        rc = chain->original_cb(s, al, chain->original_cb_arg);
+    }
+
+    return rc;    
+}
