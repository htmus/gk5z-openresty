+//------------------------------- Added Features ------------------------
+// Auxiliary recursive function
+static void
+ngx_http_lua_shdict_rbtree_walk(ngx_rbtree_node_t *node, ngx_rbtree_node_t *sentinel,
+                                u_char *prefix, size_t prefix_len, lua_State *L)
+{
+    if (node == sentinel) {
+        return;
+    }
+    
+    // Recursively traverse the left subtree
+    ngx_http_lua_shdict_rbtree_walk(node->left, sentinel, prefix, prefix_len, L);
+
+    // --- Processing the current node ---
+    ngx_http_lua_shdict_node_t *sd = (ngx_http_lua_shdict_node_t *) &node->color;
+
+    // 1. Check if the key matches our prefix
+    if (sd->key_len > prefix_len && ngx_strncmp(sd->data, prefix, prefix_len) == 0) {
+        
+        // 2. The key matched! Extract the "tail" (the anomaly code).
+        const char *reason_str = (const char *)(sd->data + prefix_len);
+        // Convert the string to a number
+        long reason_id = atol(reason_str);
+
+        // 3. Extract the value (the counter, which is stored as a double)
+        double count;
+        ngx_memcpy(&count, sd->data + sd->key_len, sizeof(double));
+
+        // 4. Put the pair (reason_id, count) into the Lua table on the stack
+        lua_pushinteger(L, reason_id); // key
+        lua_pushnumber(L, count);      // value
+        lua_settable(L, -3);           // table[key] = value
+    }
+
+    // Recursively traverse the right subtree
+    ngx_http_lua_shdict_rbtree_walk(node->right, sentinel, prefix, prefix_len, L);
+}
+//------------------------
+// Main API function
+int
+ngx_http_lua_shdict_get_by_prefix(ngx_shm_zone_t *zone, u_char *prefix_data, 
+                                  size_t prefix_len, lua_State *L)
+{
+    ngx_http_lua_shdict_ctx_t *ctx = zone->data;
+
+    // 1. We create an empty table on the Lua stack where we will store the results.
+    lua_newtable(L);
+
+    ngx_shmtx_lock(&ctx->shpool->mutex);
+
+    // 2. We start a recursive traversal of the entire tree.
+    ngx_http_lua_shdict_rbtree_walk(ctx->sh->rbtree.root, ctx->sh->rbtree.sentinel,
+                                    prefix_data, prefix_len, L);
+
+    ngx_shmtx_unlock(&ctx->shpool->mutex);
+    
+    // The results table is now on top of the stack
+    return NGX_OK; 
+}
+//------------------------
+// This function will be called directly from Lua
+static int
+ngx_http_lua_shdict_get_by_prefix_wrapper(lua_State *L)
+{
+    ngx_shm_zone_t  *zone;
+    u_char          *prefix_data;
+    size_t           prefix_len;
+    int              n;
+
+    n = lua_gettop(L);
+    if (n != 2) {
+        // We expect 2 arguments: a shdict table and a prefix string.
+        return luaL_error(L, "expecting 2 arguments (shdict, prefix), but saw %d", n);
+    }
+
+    // Argument 1: shdict table
+    if (lua_type(L, 1) != LUA_TTABLE) {
+        return luaL_error(L, "bad \"zone\" argument, expected a table");
+    }
+
+    // Argument 2: prefix
+    prefix_data = (u_char *) luaL_checklstring(L, 2, &prefix_len);
+    if (prefix_len == 0) {
+        lua_newtable(L); // Return an empty table if the prefix is ​​empty
+        return 1;
+    }
+
+    // --- Converting arguments to C types ---
+    
+    // We get a pointer to shm_zone from the Lua table (this is a standard trick in ngx_lua)
+    zone = ngx_http_lua_shdict_get_zone(L, 1);
+    if (zone == NULL) {
+        return luaL_error(L, "failed to get shm zone from the shdict table");
+    }
+
+    // --- Calling our main C function ---
+    
+    // Our C function will automatically push the result (table) onto the top of the stack.
+    ngx_http_lua_shdict_get_by_prefix(zone, prefix_data, prefix_len, L);
+
+    // We return 1 to the Lua machine because our function left 1 value (table) on the stack.
+    return 1; 
+}
