+static void
+get_ip_binary_from_connection(ngx_connection_t *c, ngx_anomaly_entry_t *entry)
+{
+    struct sockaddr_in  *sin;
+    struct sockaddr_in6 *sin6;
+
+    if (c == NULL || c->sockaddr == NULL || entry == NULL) {
+        entry->ip_type = 0;
+        return;
+    }
+
+    if (c->sockaddr->sa_family == AF_INET) {
+        sin = (struct sockaddr_in *)c->sockaddr;
+        entry->ip_type = 1;
+        entry->addr.v4 = sin->sin_addr.s_addr;
+    } else if (c->sockaddr->sa_family == AF_INET6) {
+        sin6 = (struct sockaddr_in6 *)c->sockaddr;
+        entry->ip_type = 2;
+        ngx_memcpy(entry->addr.v6, &sin6->sin6_addr, 16);
+    } else {
+        entry->ip_type = 0;
+    }
+}
